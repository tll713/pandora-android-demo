# Copy to .env for start.cmd. This file is data, not a PowerShell script.
# Local demo only. For deployment, inject environment variables without this profile.
SPRING_PROFILES_ACTIVE=demo
PANDORA_DB_USERNAME=pandora_app
PANDORA_DB_PASSWORD=
# Generate a new random secret of at least 32 bytes; never reuse demo or test keys.
PANDORA_JWT_SECRET=
