{
  "name": "pandora-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node ../scripts/test-ui.mjs",
    "test:workspace": "node tests/workspace.ui.mjs && node tests/task-tags.ui.mjs",
    "test:mobile": "node tests/mobile-details.ui.mjs",
    "check": "node --check src/app.js && node --check src/domain.js && node --check src/date-picker.js && node --check server.mjs && node --check ../web-admin/app.js",
    "build:android": "python scripts/build_android.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
